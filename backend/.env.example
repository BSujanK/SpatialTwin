# Copy to backend/.env (gitignored). Real environment variables win over this file.
# Never commit real keys.

# Qualcomm Cloud AI 100 (Cirrascale / Qualcomm AI Inference Suite, OpenAI-compatible API)
QUALCOMM_API_KEY=
QUALCOMM_ENDPOINT=https://aisuite.cirrascale.com/apis/v2
QUALCOMM_MODEL=Llama-3.1-8B

# Optional second provider (used only if Qualcomm is unset or fails)
ANTHROPIC_API_KEY=
COPILOT_MODEL=claude-haiku-5-5

# Multiplies how fast faults drift worse (1 = realistic, 5 = quick demo).
SIM_SPEED=1
